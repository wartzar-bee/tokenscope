{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wartzar-bee/tokenscope",
  "title": "Tokenscope",
  "description": "Analyze Claude Code session cost & context attribution: output, cached re-reads, cache writes.",
  "version": "0.2.3",
  "repository": {
    "url": "https://github.com/wartzar-bee/tokenscope",
    "source": "github"
  },
  "websiteUrl": "https://github.com/wartzar-bee/tokenscope#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wartzar-bee/tokenscope-mcp",
      "version": "0.2.3",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "analyze_claude_cost",
        "get_cost_benchmark",
        "tokenscope_share_summary"
      ],
      "keywords": [
        "claude-code",
        "token-cost",
        "cost-attribution",
        "context-window",
        "observability"
      ]
    }
  }
}
